  "universal_guidelines": [
    "Do not use 'Inter' for headings.",
    "Do not use Teal (#1B93A4) for main UI elements.",
    "Always use 'data-testid' on interactive elements.",
    "Use 'sonner' for toasts.",
    "Use 'lucide-react' for icons.",
    "Ensure 3:1 contrast for large text, 4.5:1 for normal text.",
    "Mobile-first responsive design is mandatory."
  ],
  "instructions_to_main_agent": "You are building the Prime Potions ERP. Follow this design system strictly. Use the provided colors and fonts. Implement the 'Bento Grid Mode B' for the dashboard. Use the provided images for the login and dashboard sections. Ensure all components are accessible and responsive."
